local function updateActionButton(playerName)
    ActionBtn.Text = "13ST CRIPZ SEARCH " .. string.upper(playerName)
end

local function createPlayerRow(player)
    if player == LocalPlayer then return end
    
    local Row = Instance.new("TextButton")
    Row.Name = player.Name
    Row.Size = UDim2.new(1, -6, 0, 35)
    Row.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Row.BorderSizePixel = 0
    Row.Text = "     " .. player.Name
    Row.TextColor3 = Color3.fromRGB(200, 200, 200)
    Row.Font = Enum.Font.SourceSans
    Row.TextSize = 14
    Row.TextXAlignment = Enum.TextXAlignment.Left
    Row.Parent = PlayerList
    
    local RowCorner = Instance.new("UICorner")
    RowCorner.CornerRadius = UDim.new(0, 6)
    RowCorner.Parent = Row
    
    local Icon = Instance.new("ImageLabel")
    Icon.Size = UDim2.new(0, 14, 0, 14)
    Icon.Position = UDim2.new(0, 8, 0, 10)
    Icon.BackgroundTransparency = 1
    Icon.Image = "rbxassetid://11419714316"
    Icon.ImageColor3 = Color3.fromRGB(0, 120, 255)
    Icon.Parent = Row

    Row.MouseButton1Click:Connect(function()
        for _, child in pairs(PlayerList:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            end
        end
        Row.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        selectedPlayer = player
        updateActionButton(player.Name)
    end)
    
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
end

local function refreshList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, player in pairs(Players:GetPlayers()) do
        createPlayerRow(player)
    end
end

Players.PlayerAdded:Connect(refreshList)
Players.PlayerRemoving:Connect(function(player)
    if selectedPlayer == player then
        selectedPlayer = nil
        ActionBtn.Text = "SELECT A PLAYER"
    end
    refreshList()
end)

refreshList()

-- Function para i-override at lagyan ng Steal logic ang mga lumilitaw na slots
local function attachStealLogic(searchGuiInstance, targetPlayer)
    local function applyToButton(button)
        if button:IsA("TextButton") or button:IsA("ImageButton") then
            -- Huwag galawin ang labas na close button ng laro
            if button.Name ~= "Close" and button.Name ~= "Exit" then
                
                -- Siguraduhing makikita mo ang Tool Name sa interface ng SearchGui
                if button:IsA("TextButton") and (button.Text == "" or button.Text == " ") then
                    button.Text = button.Name
                else
                    local nestedLabel = button:FindFirstChildOfClass("TextLabel")
                    if nestedLabel and (nestedLabel.Text == "" or nestedLabel.Text == " ") then
                        nestedLabel.Text = button.Name
                    end
                end
                
                -- Pag-click sa tool, ite-takeover natin para maging "Steal" action
                button.MouseButton1Click:Connect(function()
                    if ConfiscateEvent and targetPlayer then
                        -- I-fire ang event para piliting ilipat ng server ang tool sa iyo
                        ConfiscateEvent:FireServer(targetPlayer, button.Name)
                        print("13ST Network: Stealing tool -> " .. button.Name)
                        button:Destroy() -- Tanggalin sa UI list dahil nakuha mo na
                    end
                end)
            end
        end
    end

    -- I-apply sa mga nakasulat na ngayon
    for _, obj in pairs(searchGuiInstance:GetDescendants()) do
        applyToButton(obj)
    end

    -- Abangan kung may mga bagong tool slots na gagawin ang laro habang naglo-load
    local guiConnection
    guiConnection = searchGuiInstance.DescendantAdded:Connect(function(newObj)
        if not searchGuiInstance:IsDescendantOf(game) then
            guiConnection:Disconnect()
            return
        end
        task.wait(0.1)
        applyToButton(newObj)
    end)
end

-- MAIN TRIGGER: Pag-click ng 13ST CRIPZ SEARCH
ActionBtn.MouseButton1Click:Connect(function()
    if selectedPlayer then
        local SearchGui = PlayerGui:FindFirstChild("SearchGui")
        
        if SearchGui then
            -- Isaksak ang target player sa configuration values ng SearchGui ng laro
            for _, val in pairs(SearchGui:GetDescendants()) do
                if val:IsA("StringValue") then
                    val.Value = selectedPlayer.Name
                elseif val:IsA("ObjectValue") then
                    val.Value = selectedPlayer
                end
            end
            
            -- I-update ang header label ng laro
            for _, lbl in pairs(SearchGui:GetDescendants()) do
                if lbl:IsA("TextLabel") and (string.find(string.lower(lbl.Text), "search") or lbl.Name == "PlayerName" or lbl.Name == "Title") then
                    lbl.Text = "13ST CRIPZ STEALER: " .. string.upper(selectedPlayer.Name)
                end
            end

            -- Buksan at gawing visible ang mismong SearchGui ng laro
            if SearchGui:IsA("ScreenGui") then
                SearchGui.Enabled = true
            end
            for _, child in pairs(SearchGui:GetChildren()) do
                if child:IsA("Frame") or child:IsA("ScrollingFrame") then
                    child.Visible = true
                end
            end
            
            -- Ikonekta ang pagnanakaw ng tools
            attachStealLogic(SearchGui, selectedPlayer)
        else
            warn("13ST Network: 'SearchGui' not found inside PlayerGui!")
        end
        
        -- Utusan ang server na hilahin ang data ng imbentaryo ng biktima papunta sa screen mo
        if SearchEvent then
            SearchEvent:FireServer(selectedPlayer)
        end
        
    else
        ActionBtn.Text = "CHOOSE A PLAYER FIRST!"
        task.wait(1)
        if selectedPlayer then updateActionButton(selectedPlayer.Name) else ActionBtn.Text = "SELECT A PLAYER" end
    end
end)
